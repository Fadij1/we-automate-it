# .env.example - Copy to .env and configure secret keys

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Online Cloud Excel / Google Sheets Live Sync Webhook URL
# Paste your deployed Google Apps Script Web App URL below
# (Follow the 1-minute instructions in google_sheet_script.js)
ONLINE_EXCEL_WEBHOOK_URL=https://script.google.com/macros/s/AKfycby05NpGFMqHcE_r3XPJCu9LcEiQqXPU_7WH1KyGfjIknu9s06qAfDVVYiVcJz4-GUiG/exec

# SMTP Email Configuration for Contact Notifications
SENDER_EMAIL=your_sender_email@gmail.com
SENDER_PASSWORD=your_gmail_app_password_here
RECEIVER_EMAIL=your_receiver_email@gmail.com
